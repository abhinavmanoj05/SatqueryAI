# SatQuery AI - Environment Configuration
# ----------------------------------------
# Google Gemini API key for production Vision-Language tasks (VQA, Grounding, Change Analysis)
# Free tier from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Preferred Gemini model: "gemini-2.0-flash" (default stable workhorse), "gemini-3.8-flash", or "gemini-3.5-flash"
GEMINI_MODEL=gemini-2.0-flash

# Optional: Local Ollama model for query NLP thinking (e.g., "llama-3.2", "deepseek-r1:8b", "qwen3-vl:4b")
OLLAMA_MODEL=richardyoung/llama-3.2-3b-instruct-abliterated:latest

# Optional: OpenRouter API Key for Qwen 2.5-VL 72B (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
